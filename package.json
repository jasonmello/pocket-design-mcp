{
  "name": "pocket-design-mcp",
  "version": "0.3.0",
  "description": "Free MCP server with icons, fonts, images, components, design tokens, easings, contrast checks, SVG tools and patterns for coding agents.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node test/smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "prepublishOnly": "npm run build"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "svgo": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "pocket-design-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "design",
    "design-tokens",
    "icons",
    "fonts",
    "shadcn",
    "tailwind",
    "easing",
    "contrast",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonmello/pocket-design-mcp.git"
  },
  "homepage": "https://github.com/jasonmello/pocket-design-mcp#readme",
  "bugs": {
    "url": "https://github.com/jasonmello/pocket-design-mcp/issues"
  }
}
